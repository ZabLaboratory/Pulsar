{
  "name": "@clodocapeo/capture-pgm-compat",
  "version": "0.1.0",
  "private": true,
  "description": "Proves Pulsar's capture path and its recorded PGM are compatible: a spatial+temporal per-frame health measure over a real record, plus a real-Pulsar/CEF integration harness for the healthy/black/frozen scenarios named in ZabLaboratory/Pulsar#231. Not published -- internal test tooling.",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZabLaboratory/Pulsar.git",
    "directory": "packages/capture-pgm-compat"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clodocapeo/pgm-correlator": "^0.1.0",
    "@clodocapeo/pulsar-bundle-full": "^1.8.0",
    "@clodocapeo/pulsar-client": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
