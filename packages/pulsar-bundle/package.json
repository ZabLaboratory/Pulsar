{
  "name": "@clodocapeo/pulsar-bundle",
  "version": "1.8.4",
  "description": "Bundles pulsar.exe + DLLs and exposes a Node spawn() API. Pairs with @clodocapeo/pulsar-client. For HTML overlays / browser sources, use @clodocapeo/pulsar-bundle-full instead.",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZabLaboratory/Pulsar.git",
    "directory": "packages/pulsar-bundle"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "postinstall": "node scripts/postinstall.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@clodocapeo/pulsar-client": "1.8.4"
  },
  "devDependencies": {
    "@msgpack/msgpack": "^3.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
