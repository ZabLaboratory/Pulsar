/* Version resource for the fake SDK DLLs. The capability probe reads this
 * with GetFileVersionInfo* off an absolute path -- so a test that could not
 * produce a real VS_VERSION_INFO block would not be testing the probe at
 * all, only its error path. Configured twice: 1.6.1.2 ("good", clears both
 * minima) and 0.0.0.1 ("evil", clears neither). */

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PULSAR_NV_FAKE_VER_COMMA@
PRODUCTVERSION @PULSAR_NV_FAKE_VER_COMMA@
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Pulsar test fixture -- not NVIDIA"
            VALUE "FileDescription",  "pulsar nv-probe fake SDK DLL"
            VALUE "FileVersion",      "@PULSAR_NV_FAKE_VER_DOT@"
            VALUE "InternalName",     "fake-nv-sdk"
            VALUE "ProductName",      "Pulsar nv-probe fixtures"
            VALUE "ProductVersion",   "@PULSAR_NV_FAKE_VER_DOT@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
