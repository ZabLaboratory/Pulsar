+		DARRAY(struct obs_borrowed_video_callback) callbacks = {0};
+		int slot_index = -1;
 		pthread_mutex_lock(&video->borrowed_video_mutex);
-		while (!video->borrowed_video_pending && !video->borrowed_video_stop)
+		while (video->borrowed_video_pending_slot < 0 && !video->borrowed_video_stop)
 			pthread_cond_wait(&video->borrowed_video_cond, &video->borrowed_video_mutex);
 
 		if (video->borrowed_video_stop) {
@@ -616,16 +618,25 @@ static void *borrowed_video_thread(void *data)
 			break;
 		}
 
-		video->borrowed_video_pending = false;
-		video->borrowed_video_busy = true;
+		slot_index = video->borrowed_video_pending_slot;
+		video->borrowed_video_pending_slot = -1;
+		video->borrowed_video_busy_slot = slot_index;
+		video->borrowed_video_slots[slot_index].busy = true;
+		da_copy(callbacks, video->borrowed_video_callbacks);
+		pthread_mutex_unlock(&video->borrowed_video_mutex);
+
 		const uint64_t publish_start = os_gettime_ns();
-		for (size_t i = 0; i < video->borrowed_video_callbacks.num; i++) {
