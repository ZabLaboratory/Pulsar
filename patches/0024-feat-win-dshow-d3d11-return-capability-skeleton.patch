+	ComPtr<IDXGIKeyedMutex> mutexes[PULSAR_D3D11_RETURN_SLOT_COUNT];
+	HANDLE source_handles[PULSAR_D3D11_RETURN_SLOT_COUNT] = {};
+	uint32_t consumer_pid = 0;
