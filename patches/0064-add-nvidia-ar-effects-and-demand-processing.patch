+static void nvvfx_frame_subject(struct nvvfx_data *filter)
+{
+    const pulsar_ar_rect *subject = NULL;
+    for (uint8_t i = 0; i < filter->ar_boxes.num_boxes && i < 25; ++i) {
+        const pulsar_ar_rect *box = &filter->ar_rects[i];
+        if (isfinite(box->x) && isfinite(box->y) && isfinite(box->width) && isfinite(box->height) &&
+            box->width > 0.f && box->height > 0.f && (!subject || box->width * box->height > subject->width * subject->height))
+            subject = box;
+    }
+    float x = filter->crop_x, y = filter->crop_y, size = filter->crop_size;
+    if (subject) {
+        filter->lost_seconds = 0.f;
+        size = fminf(1.f, fmaxf(1.f / filter->zoom, fmaxf(subject->width / filter->width * 4.f, subject->height / filter->height * 4.f)));
+        x = fmaxf(0.f, fminf(1.f - size, (subject->x + subject->width * .5f) / filter->width - size * .5f));
+        y = fmaxf(0.f, fminf(1.f - size, (subject->y + subject->height * 1.3f) / filter->height - size * .5f));
+    } else {
+        filter->lost_seconds += filter->frame_seconds;
+        if (filter->lost_seconds > 1.f) {
+            x = y = 0.f;
+            size = 1.f;
+        }
+    }
+    float weight = 1.f - expf(-filter->frame_seconds / filter->smoothing);
+    filter->crop_x += (x - filter->crop_x) * weight;
+    filter->crop_y += (y - filter->crop_y) * weight;
+    filter->crop_size += (size - filter->crop_size) * weight;
+}
