+struct nvvfx_metrics_call { struct nvvfx_data *filter; calldata_t *result; };
+static void nvvfx_metrics_graphics(void *data)
+{
+    struct nvvfx_metrics_call *call = data;
+    struct nvvfx_data *filter = call->filter;
+    calldata_set_int(call->result, "processed_frames", filter->processed_count);
+    calldata_set_float(call->result, "last_processing_ms", filter->last_processing_ns / 1000000.0);
+    calldata_set_bool(call->result, "images_allocated", filter->images_allocated);
+    calldata_set_bool(call->result, "processing_stopped", filter->processing_stop);
+}
+static void nvvfx_metrics(void *data, calldata_t *result)
+{
+    struct nvvfx_metrics_call call = { data, result };
+    // Read only on the owning graphics thread while the caller holds the source.
+    obs_queue_task(OBS_TASK_GRAPHICS, nvvfx_metrics_graphics, &call, true);
+}
