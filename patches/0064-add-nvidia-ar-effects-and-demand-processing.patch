@@ -5,6 +5,8 @@ uniform texture2d image;
 uniform float multiplier;
 uniform float compare;
 uniform float processed_mix;
+uniform float2 crop_offset;
+uniform float crop_size;
 uniform texture2d mask;
 uniform texture2d blurred;
 
@@ -55,10 +57,11 @@ FragPos VSConvertUnorm(uint id : VERTEXID)
 
 float4 Mask(FragData f_in)
 {
-	float4 rgba = image.Sample(texSampler, f_in.uv);
-	float3 blur = srgb_nonlinear_to_linear(blurred.Sample(texSampler, f_in.uv).rgb);
+	float2 uv = (compare > 0.5 && f_in.uv.x < 0.5) ? f_in.uv : crop_offset + f_in.uv * crop_size;
+    float4 rgba = image.Sample(texSampler, uv);
+	float3 blur = srgb_nonlinear_to_linear(blurred.Sample(texSampler, uv).rgb);
 	// Between blurred and unblurred area we interpolate to have a smooth transition.
-	float m = smoothstep(0.85, 0.95, mask.Sample(texSampler, f_in.uv).a);
+	float m = smoothstep(0.85, 0.95, mask.Sample(texSampler, uv).a);
 	float mix_amount = (compare > 0.5 && f_in.uv.x < 0.5) ? 0.0 : processed_mix;
 	float3 out_lin = lerp(rgba.rgb, lerp(blur, rgba.rgb, m), mix_amount);
 	return float4(out_lin, rgba.a);
