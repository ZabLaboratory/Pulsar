From 0c31ca09c6037790d2c486276626910f27812449 Mon Sep 17 00:00:00 2001
From: Forge <forge@example.invalid>
Date: Thu, 3 Sep 2026 14:59:30 +0200
Subject: [PATCH] fix(replay): stop buffer on next packet deterministically

Agent-Role: forge

Work-Unit: ZabLaboratory/Pulsar#254

Issue: 254
---
 plugins/obs-ffmpeg/obs-ffmpeg-mux.c | 19 ++++++++++++++-----
 1 file changed, 14 insertions(+), 5 deletions(-)

diff --git a/plugins/obs-ffmpeg/obs-ffmpeg-mux.c b/plugins/obs-ffmpeg/obs-ffmpeg-mux.c
index f152b2849..f55814407 100644
--- a/plugins/obs-ffmpeg/obs-ffmpeg-mux.c
+++ b/plugins/obs-ffmpeg/obs-ffmpeg-mux.c
@@ -510,6 +510,17 @@ void ffmpeg_mux_stop(void *data, uint64_t ts)
 	}
 }
 
+static void replay_buffer_stop(void *data, uint64_t ts)
+{
+	struct ffmpeg_muxer *stream = data;
+	(void)ts;
+	if (capturing(stream) || active(stream)) {
+		stream->stop_ts = 0;
+		os_atomic_set_bool(&stream->stopping, true);
+		os_atomic_set_bool(&stream->capturing, false);
+	}
+}
+
 static void signal_failure(struct ffmpeg_muxer *stream)
 {
 	char error[1024];
@@ -1215,10 +1226,8 @@ static void replay_buffer_data(void *data, struct encoder_packet *packet)
 	}
 
 	if (stopping(stream)) {
-		if (packet->sys_dts_usec >= stream->stop_ts) {
-			deactivate_replay_buffer(stream, 0);
-			return;
-		}
+		deactivate_replay_buffer(stream, 0);
+		return;
 	}
 
 	obs_encoder_packet_ref(&pkt, packet);
@@ -1260,7 +1271,7 @@ struct obs_output_info replay_buffer = {
 	.create = replay_buffer_create,
 	.destroy = replay_buffer_destroy,
 	.start = replay_buffer_start,
-	.stop = ffmpeg_mux_stop,
+	.stop = replay_buffer_stop,
 	.encoded_packet = replay_buffer_data,
 -- 
