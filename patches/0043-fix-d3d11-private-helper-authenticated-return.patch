+		envelope.magic = PULSAR_RETURN_AUTH_FRAME_MAGIC;
+		envelope.version = PULSAR_RETURN_AUTH_VERSION;
+		envelope.width = bootstrap.width;
+		envelope.height = bootstrap.height;
