From 84b07d39f38cd6b31f653bbcfc8c8df6feb5bdc2 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?ClodoCap=C3=A9o?=
 <159788250+ClodoCapeo@users.noreply.github.com>
Date: Mon, 7 Sep 2026 16:54:44 +0200
Subject: [PATCH] perf(nvenc): service asynchronous output

Submit with registered completion events and collect between video ticks. Preserve compression settings, FIFO input lifetime, PTS and DTS. Keep bounded resource-pressure waits and the existing libobs encoder thread.

Agent-Role: eleven

Agent-Thread: 01a045e2-996f-7913-99f0-2cd237d3a6f8

Work-Unit: ZabLaboratory/Pulsar#253

Issue: ZabLaboratory/Pulsar#253
---
 libobs/obs-encoder.h               | 10 ++--
 libobs/obs-video-gpu-encode.c      | 43 +++++++++++++++-
 libobs/util/threading-windows.c    | 10 ++++
 libobs/util/threading.h            |  5 ++
 plugins/obs-nvenc/nvenc-d3d11.c    |  7 +++
 plugins/obs-nvenc/nvenc-internal.h |  5 ++
 plugins/obs-nvenc/nvenc.c          | 78 ++++++++++++++++++++++++++++--
 7 files changed, 149 insertions(+), 9 deletions(-)

diff --git a/libobs/obs-encoder.h b/libobs/obs-encoder.h
index f4b644fad..6605d203b 100644
--- a/libobs/obs-encoder.h
+++ b/libobs/obs-encoder.h
@@ -364,10 +364,12 @@ struct obs_encoder_info {
 	/** Audio encoder only: Returns padding, in samples, that must be skipped at the start of the stream. */
 	uint32_t (*get_priming_samples)(void *data);
 
-	/** Optional pull of another already-ready packet after encode returned.
-	 * Called on the same encoder thread, after timing registration and delivery
-	 * of the encode result. Must not submit a new image, flush, or wait for new
-	 * input. Return received=false once the ready batch is exhausted.
+	/** Optional pull of another packet whose input was already submitted.
+	 * Called on the same encoder thread after timing registration, before a
+	 * later input, or between inputs when completion service is enabled. Must
+	 * not submit a new image, flush, or wait for new input. It may wait for an
+	 * existing completion only when the resource pool is full (backpressure).
+	 * Return received=false once the currently ready batch is exhausted.
 	 * Packet storage remains owned by the encoder until the next encoder call.
 	 * Appended for size-based registration compatibility with older plugins. */
 	bool (*get_pending_packet)(void *data, struct encoder_packet *packet, bool *received_packet);
diff --git a/libobs/obs-video-gpu-encode.c b/libobs/obs-video-gpu-encode.c
index 5bbf04105..1da00d2ee 100644
--- a/libobs/obs-video-gpu-encode.c
+++ b/libobs/obs-video-gpu-encode.c
@@ -16,6 +16,8 @@
 ******************************************************************************/
 
 #include "obs-internal.h"
+#include <stdlib.h>
+#include <errno.h>
 
 #define NBSP "\xC2\xA0"
 static const char *gpu_encode_frame_name = "gpu_encode_frame";
@@ -25,6 +27,10 @@ static void *gpu_encode_thread(void *data)
 	uint64_t interval = video_output_get_frame_time(video->video);
 	DARRAY(obs_encoder_t *) encoders;
 	int wait_frames = NUM_ENCODE_TEXTURE_FRAMES_TO_WAIT;
+#ifdef _WIN32
+	const char *async_mode = getenv("PULSAR_NVENC_ASYNC_OUTPUT");
+	const bool service_completions = async_mode && strcmp(async_mode, "1") == 0;
+#endif
 
 	da_init(encoders);
 
@@ -33,7 +39,38 @@ static void *gpu_encode_thread(void *data)
 		obs_get_profiler_name_store(), "obs_gpu_encode_thread(%g" NBSP "ms)", interval / 1000000.);
 	profile_register_root(gpu_encode_thread_name, interval);
 
-	while (os_sem_wait(video->gpu_encode_semaphore) == 0) {
+	for (;;) {
+		/* Completion service never consumes a frame on timeout. Keep the
+		 * existing encoder thread and inactive barrier: plugin state and
+		 * packet timing arrays are never accessed from a new callback thread. */
+		int wait_result;
+#ifdef _WIN32
+		wait_result = service_completions ? os_sem_timedwait(video->gpu_encode_semaphore, 1)
+						 : os_sem_wait(video->gpu_encode_semaphore);
+#else
+		wait_result = os_sem_wait(video->gpu_encode_semaphore);
+#endif
+		if (os_atomic_load_bool(&video->gpu_encode_stop))
+			break;
+		if (wait_result == ETIMEDOUT) {
+			os_event_reset(video->gpu_encode_inactive);
+			pthread_mutex_lock(&video->gpu_encoder_mutex);
+			for (size_t i = 0; i < video->gpu_encoders.num; i++) {
+				obs_encoder_t *encoder = obs_encoder_get_ref(video->gpu_encoders.array[i]);
+				if (encoder)
+					da_push_back(encoders, &encoder);
+			}
+			pthread_mutex_unlock(&video->gpu_encoder_mutex);
+			for (size_t i = 0; i < encoders.num; i++)
+				drain_encoder_packets(encoders.array[i]);
+			os_event_signal(video->gpu_encode_inactive);
+			for (size_t i = 0; i < encoders.num; i++)
+				obs_encoder_release(encoders.array[i]);
+			da_resize(encoders, 0);
+			continue;
+		}
+		if (wait_result != 0)
+			break;
 		struct obs_tex_frame tf;
 		uint64_t timestamp;
 		uint64_t lock_key;
@@ -81,6 +118,10 @@ static void *gpu_encode_thread(void *data)
 			uint32_t skip = 0;
 
 			obs_encoder_t *encoder = encoders.array[i];
+			/* Retire completed surfaces before a producer can reuse the next
+			 * input slot. A full pool may apply bounded backpressure here. */
+			if (!drain_encoder_packets(encoder))
+				continue;
 			obs_weak_encoder_t **paired = encoder->paired_encoders.array;
 			size_t num_paired = encoder->paired_encoders.num;
 
diff --git a/libobs/util/threading-windows.c b/libobs/util/threading-windows.c
index 4ccc97841..c56680791 100644
--- a/libobs/util/threading-windows.c
+++ b/libobs/util/threading-windows.c
@@ -152,6 +152,16 @@ int os_sem_wait(os_sem_t *sem)
 	return (ret == WAIT_OBJECT_0) ? 0 : -1;
 }
 
+int os_sem_timedwait(os_sem_t *sem, unsigned long milliseconds)
+{
+	if (!sem)
+		return -1;
+	DWORD ret = WaitForSingleObject((HANDLE)sem, milliseconds);
+	if (ret == WAIT_TIMEOUT)
+		return ETIMEDOUT;
+	return ret == WAIT_OBJECT_0 ? 0 : -1;
+}
+
 #define VC_EXCEPTION 0x406D1388
 
 #pragma pack(push, 8)
diff --git a/libobs/util/threading.h b/libobs/util/threading.h
index 8ee35bc56..b614a65dc 100644
--- a/libobs/util/threading.h
+++ b/libobs/util/threading.h
@@ -89,6 +89,11 @@ EXPORT int os_sem_init(os_sem_t **sem, int value);
 EXPORT void os_sem_destroy(os_sem_t *sem);
 EXPORT int os_sem_post(os_sem_t *sem);
 EXPORT int os_sem_wait(os_sem_t *sem);
+#ifdef _WIN32
+/* Returns 0 after consuming one post, ETIMEDOUT without consuming a post,
+ * or -1 on failure. Used for bounded completion service between video ticks. */
+EXPORT int os_sem_timedwait(os_sem_t *sem, unsigned long milliseconds);
+#endif
 
 EXPORT void os_set_thread_name(const char *name);
 
diff --git a/plugins/obs-nvenc/nvenc-d3d11.c b/plugins/obs-nvenc/nvenc-d3d11.c
index cb5532ab7..21ddab521 100644
--- a/plugins/obs-nvenc/nvenc-d3d11.c
+++ b/plugins/obs-nvenc/nvenc-d3d11.c
@@ -226,6 +226,13 @@ bool d3d11_encode(void *data, struct encoder_texture *texture, int64_t pts, uint
 
 	bs = &enc->bitstreams.array[enc->next_bitstream];
 	nvtex = &enc->textures.array[enc->next_bitstream];
+	if (enc->async_output && nvtex->mapped_res) {
+		/* libobs must drain with backpressure before reusing an in-flight
+		 * slot. Never copy over a surface still owned by NVENC. */
+		*next_key = lock_key;
+		NV_FAIL("Asynchronous input surface has not been retired before reuse");
+		return false;
+	}
 
 	input_tex = get_tex_from_handle(enc, texture->handle, &km);
 	output_tex = nvtex->tex;
diff --git a/plugins/obs-nvenc/nvenc-internal.h b/plugins/obs-nvenc/nvenc-internal.h
index 6db886d4a..f8142743c 100644
--- a/plugins/obs-nvenc/nvenc-internal.h
+++ b/plugins/obs-nvenc/nvenc-internal.h
@@ -72,6 +72,7 @@ struct nvenc_data {
 	int buffers_queued;
 	int buffers_ready;
 	bool ready_drain;
+	bool async_output;
 	size_t next_bitstream;
 	size_t cur_bitstream;
 	bool encode_started;
@@ -140,6 +141,10 @@ struct handle_tex {
 /* Bitstream buffer */
 struct nv_bitstream {
 	void *ptr;
+#ifdef _WIN32
+	HANDLE completion_event;
+	bool completion_ready;
+#endif
 };
 
 /** Mapped resources **/
diff --git a/plugins/obs-nvenc/nvenc.c b/plugins/obs-nvenc/nvenc.c
index 62708e7a9..8ef65fbff 100644
--- a/plugins/obs-nvenc/nvenc.c
+++ b/plugins/obs-nvenc/nvenc.c
@@ -19,6 +19,7 @@
 
 static bool nv_bitstream_init(struct nvenc_data *enc, struct nv_bitstream *bs)
 {
+	memset(bs, 0, sizeof(*bs));
 	NV_ENC_CREATE_BITSTREAM_BUFFER buf = {NV_ENC_CREATE_BITSTREAM_BUFFER_VER};
 
 	if (NV_FAILED(nv.nvEncCreateBitstreamBuffer(enc->session, &buf))) {
@@ -26,11 +27,39 @@ static bool nv_bitstream_init(struct nvenc_data *enc, struct nv_bitstream *bs)
 	}
 
 	bs->ptr = buf.bitstreamBuffer;
+#ifdef _WIN32
+	if (enc->async_output) {
+		bs->completion_event = CreateEventW(NULL, FALSE, FALSE, NULL);
+		if (!bs->completion_event) {
+			nv.nvEncDestroyBitstreamBuffer(enc->session, bs->ptr);
+			bs->ptr = NULL;
+			return false;
+		}
+		NV_ENC_EVENT_PARAMS event = {NV_ENC_EVENT_PARAMS_VER};
+		event.completionEvent = bs->completion_event;
+		if (NV_FAILED(nv.nvEncRegisterAsyncEvent(enc->session, &event))) {
+			CloseHandle(bs->completion_event);
+			bs->completion_event = NULL;
+			nv.nvEncDestroyBitstreamBuffer(enc->session, bs->ptr);
+			bs->ptr = NULL;
+			return false;
+		}
+	}
+#endif
 	return true;
 }
 
 static void nv_bitstream_free(struct nvenc_data *enc, struct nv_bitstream *bs)
 {
+#ifdef _WIN32
+	if (bs->completion_event) {
+		NV_ENC_EVENT_PARAMS event = {NV_ENC_EVENT_PARAMS_VER};
+		event.completionEvent = bs->completion_event;
+		nv.nvEncUnregisterAsyncEvent(enc->session, &event);
+		CloseHandle(bs->completion_event);
+		bs->completion_event = NULL;
+	}
+#endif
 	if (bs->ptr) {
 		nv.nvEncDestroyBitstreamBuffer(enc->session, bs->ptr);
 	}
@@ -333,6 +362,18 @@ static bool init_encoder_base(struct nvenc_data *enc, obs_data_t *settings)
 			   strcmp(ready_drain, "1") == 0;
 	if (enc->ready_drain)
 		info("Pulsar ready-batch drain enabled (surface pool and compression settings preserved)");
+	const char *async_output = getenv("PULSAR_NVENC_ASYNC_OUTPUT");
+	enc->async_output = enc->codec == CODEC_H264 && !enc->non_texture &&
+			    nv_tuning == NV_ENC_TUNING_INFO_ULTRA_LOW_LATENCY && async_output &&
+			    strcmp(async_output, "1") == 0;
+	if (enc->async_output) {
+		if (!nv_get_cap(enc, NV_ENC_CAPS_ASYNC_ENCODE_SUPPORT)) {
+			NV_FAIL("Asynchronous completion requested but unsupported by this encoder/driver");
+			return false;
+		}
+		enc->params.enableEncodeAsync = 1;
+		info("Pulsar asynchronous output enabled (completion events; compression and surface pool preserved)");
+	}
 #endif
 
 	if (lookahead) {
@@ -1094,7 +1135,7 @@ static bool get_encoded_packet(struct nvenc_data *enc, bool finalize)
 
 	if (!enc->buffers_queued)
 		return true;
-	if (!finalize) {
+	if (!finalize && !enc->async_output) {
 		if (enc->ready_drain ? !enc->buffers_ready : enc->buffers_queued < enc->output_delay)
 			return true;
 	}
@@ -1104,6 +1145,22 @@ static bool get_encoded_packet(struct nvenc_data *enc, bool finalize)
 	for (size_t i = 0; i < count; i++) {
 		size_t cur_bs_idx = enc->cur_bitstream;
 		struct nv_bitstream *bs = &enc->bitstreams.array[cur_bs_idx];
+#ifdef _WIN32
+		/* Only block at EOS or genuine pool exhaustion, never merely because
+		 * the next video tick has arrived. Event order follows submission,
+		 * while outputTimeStamp retains presentation order for B-frames. */
+		bool must_wait = finalize || enc->buffers_queued >= (int)enc->buf_count;
+		if (enc->async_output && !bs->completion_ready) {
+			DWORD result = WaitForSingleObject(bs->completion_event, must_wait ? 10000 : 0);
+			if (result == WAIT_TIMEOUT && !must_wait)
+				return true;
+			if (result != WAIT_OBJECT_0) {
+				NV_FAIL("Asynchronous bitstream completion wait failed (%lu)", result);
+				return false;
+			}
+			bs->completion_ready = true;
+		}
+#endif
 #ifdef _WIN32
 		struct nv_texture *nvtex = enc->non_texture ? NULL : &enc->textures.array[cur_bs_idx];
 		struct nv_cuda_surface *surf = enc->non_texture ? &enc->surfaces.array[cur_bs_idx] : NULL;
@@ -1116,8 +1173,13 @@ static bool get_encoded_packet(struct nvenc_data *enc, bool finalize)
 		NV_ENC_LOCK_BITSTREAM lock = {NV_ENC_LOCK_BITSTREAM_VER};
 		lock.outputBitstream = bs->ptr;
 		lock.doNotWait = false;
-
-		if (NV_FAILED(nv.nvEncLockBitstream(s, &lock))) {
+#ifdef _WIN32
+		lock.doNotWait = enc->async_output && !must_wait;
+#endif
+		NVENCSTATUS lock_result = nv.nvEncLockBitstream(s, &lock);
+		if (enc->async_output && lock.doNotWait && lock_result == NV_ENC_ERR_LOCK_BUSY)
+			return true;
+		if (NV_FAILED(lock_result)) {
 			return false;
 		}
 
@@ -1194,6 +1256,9 @@ static bool get_encoded_packet(struct nvenc_data *enc, bool finalize)
 			enc->cur_bitstream = 0;
 
 		enc->buffers_queued--;
+#ifdef _WIN32
+		bs->completion_ready = false;
+#endif
 		if (enc->ready_drain && enc->buffers_ready)
 			enc->buffers_ready--;
 	}
@@ -1223,7 +1288,7 @@ static bool nvenc_pending_packet(void *data, struct encoder_packet *packet, bool
 {
 	struct nvenc_data *enc = data;
 	*received_packet = false;
-	if (!enc->ready_drain || !enc->buffers_ready)
+	if (enc->async_output ? !enc->buffers_queued : (!enc->ready_drain || !enc->buffers_ready))
 		return true;
 	if (!get_encoded_packet(enc, false))
 		return false;
@@ -1362,6 +1427,11 @@ bool nvenc_encode_base(struct nvenc_data *enc, struct nv_bitstream *bs, void *pi
 	if (obs_encoder_has_roi(enc->encoder))
 		add_roi(enc, &params);
 
+#ifdef _WIN32
+	if (enc->async_output)
+		params.completionEvent = bs->completion_event;
+#endif
+
 	NVENCSTATUS err = nv.nvEncEncodePicture(enc->session, &params);
 	if (err != NV_ENC_SUCCESS && err != NV_ENC_ERR_NEED_MORE_INPUT) {
 		nv_failed(enc->encoder, err, __FUNCTION__, "nvEncEncodePicture");
-- 
