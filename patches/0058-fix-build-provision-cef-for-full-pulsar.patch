From 0000000000000000000000000000000000000058 Mon Sep 17 00:00:00 2001
From: ClodoCapeo <159788250+ClodoCapeo@users.noreply.github.com>
Date: Wed, 7 Oct 2026 19:15:00 +0200
Subject: [PATCH] fix(build): provision CEF for the full Pulsar browser

Keep the upstream browser disabled while fetching its pinned CEF dependency
for the separate Pulsar browser target when PULSAR_REQUIRE_CEF is enabled.

diff --git a/cmake/common/buildspec_common.cmake b/cmake/common/buildspec_common.cmake
index 8d01026e5..ddce0325c 100644
--- a/cmake/common/buildspec_common.cmake
+++ b/cmake/common/buildspec_common.cmake
@@ -79,7 +79,7 @@ function(_check_dependencies)
   _get_dependency_data(dependency_data)
 
   foreach(dependency IN LISTS dependencies_list)
-    if(dependency STREQUAL cef AND NOT ENABLE_BROWSER)
+    if(dependency STREQUAL cef AND NOT ENABLE_BROWSER AND NOT PULSAR_REQUIRE_CEF)
       continue()
     endif()
     if(dependency STREQUAL cef AND arch STREQUAL universal)
@@ -133,7 +133,7 @@ function(_check_dependencies)
         endif()
       endif()
     elseif(dependency STREQUAL cef)
-      if(NOT ENABLE_BROWSER)
+      if(NOT ENABLE_BROWSER AND NOT PULSAR_REQUIRE_CEF)
         set(skip TRUE)
       elseif(OBS_DEPENDENCY_${dependency}_${arch}_HASH STREQUAL ${hash} AND (CEF_ROOT_DIR AND EXISTS "${CEF_ROOT_DIR}"))
         set(skip TRUE)
