From: =?UTF-8?q?ClodoCap=C3=A9o?=
 <159788250+ClodoCapeo@users.noreply.github.com>
Date: Sat, 10 Oct 2026 15:12:26 +0200
Subject: [PATCH] feat(nvidia): native video noise removal and same-frame
 comparison

Continue local-20261010 NVIDIA parity. Reuse the private upstream GPU interop and image/state lifetime for the Denoising SDK consumer; no second camera, CPU pixel readback or redistributed SDK. Expose two model strengths and independently blended intensity, exact zero bypass, original alpha and same-frame split. This private filter pipeline change is maintained as a downstream patch and is a candidate for upstream contribution after qualification.
---
 plugins/nv-filters/data/rtx_blur.effect       |   5 +-
 .../nv-filters/data/rtx_greenscreen.effect    |   3 +
 plugins/nv-filters/nv-filters.c               |   9 +
 plugins/nv-filters/nvidia-videofx-filter.c    | 167 ++++++++++++++++--
 4 files changed, 165 insertions(+), 19 deletions(-)

diff --git a/plugins/nv-filters/data/rtx_blur.effect b/plugins/nv-filters/data/rtx_blur.effect
index 32ab2df80..89824b8c2 100644
--- a/plugins/nv-filters/data/rtx_blur.effect
+++ b/plugins/nv-filters/data/rtx_blur.effect
@@ -3,6 +3,8 @@
 uniform float4x4 ViewProj;
 uniform texture2d image;
 uniform float multiplier;
+uniform float compare;
+uniform float processed_mix;
 uniform texture2d mask;
 uniform texture2d blurred;
 
@@ -57,7 +59,8 @@ float4 Mask(FragData f_in)
 	float3 blur = srgb_nonlinear_to_linear(blurred.Sample(texSampler, f_in.uv).rgb);
 	// Between blurred and unblurred area we interpolate to have a smooth transition.
 	float m = smoothstep(0.85, 0.95, mask.Sample(texSampler, f_in.uv).a);
-	float3 out_lin = lerp(blur, rgba.rgb, m);
+	float mix_amount = (compare > 0.5 && f_in.uv.x < 0.5) ? 0.0 : processed_mix;
+	float3 out_lin = lerp(rgba.rgb, lerp(blur, rgba.rgb, m), mix_amount);
 	return float4(out_lin, rgba.a);
 }
 
diff --git a/plugins/nv-filters/data/rtx_greenscreen.effect b/plugins/nv-filters/data/rtx_greenscreen.effect
index fc945d232..df93ed88f 100644
--- a/plugins/nv-filters/data/rtx_greenscreen.effect
+++ b/plugins/nv-filters/data/rtx_greenscreen.effect
@@ -3,6 +3,7 @@
 uniform float4x4 ViewProj;
 uniform texture2d image;
 uniform float multiplier;
+uniform float compare;
 
 uniform texture2d mask;
 uniform float threshold;
@@ -55,6 +56,8 @@ FragPos VSConvertUnorm(uint id : VERTEXID)
 float4 Mask(FragData f_in)
 {
 	float4 rgba = image.Sample(texSampler, f_in.uv);
+	if (compare > 0.5 && f_in.uv.x < 0.5)
+		return rgba;
 	rgba *= smoothstep(threshold - 0.1,threshold,mask.Sample(texSampler, f_in.uv).a);
 	return rgba;
 }
