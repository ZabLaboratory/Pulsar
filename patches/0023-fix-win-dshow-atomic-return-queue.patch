+		memcpy(destination + (size_t)row * cx, data[0] + (size_t)row * linesize[0], cx);
+
+	destination += (size_t)cx * cy;
+	for (uint32_t row = 0; row < cy / 2; ++row)
+		memcpy(destination + (size_t)row * cx, data[1] + (size_t)row * linesize[1], cx);
