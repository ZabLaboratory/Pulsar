From 7c98c4b872c680488c99671a0dbb4230936d48f0 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?ClodoCap=C3=A9o?=
 <159788250+ClodoCapeo@users.noreply.github.com>
Date: Mon, 7 Sep 2026 14:36:12 +0200
Subject: [PATCH] perf(libobs): evaluate current-surface readback with content
 identity

Agent-Role: Eleven

Agent-Thread: /root

Work-Unit: ZabLaboratory/Pulsar#253

Issue: 253

Evidence: preserve cadence counts and timestamps, reject precommit DirectShow content; candidate validation pending
---
 libobs/media-io/video-io.c     |  7 +++++++
 libobs/media-io/video-io.h     |  4 ++++
 libobs/obs-encoder.c           |  3 ++-
 libobs/obs-encoder.h           |  1 +
 libobs/obs-video.c             | 22 +++++++++++++++++++---
 plugins/win-dshow/virtualcam.c |  8 ++++----
 6 files changed, 37 insertions(+), 8 deletions(-)

diff --git a/libobs/media-io/video-io.c b/libobs/media-io/video-io.c
index ec6b4243f..7aeb7fc42 100644
--- a/libobs/media-io/video-io.c
+++ b/libobs/media-io/video-io.c
@@ -507,6 +507,12 @@ const struct video_output_info *video_output_get_info(const video_t *video)
 }
 
 bool video_output_lock_frame(video_t *video, struct video_frame *frame, int count, uint64_t timestamp)
+{
+	return video_output_lock_frame_with_content(video, frame, count, timestamp, timestamp);
+}
+
+bool video_output_lock_frame_with_content(video_t *video, struct video_frame *frame, int count,
+					 uint64_t timestamp, uint64_t content_pts_ns)
 {
 	struct cached_frame_info *cfi;
 	bool locked;
@@ -531,6 +537,7 @@ bool video_output_lock_frame(video_t *video, struct video_frame *frame, int coun
 
 		cfi = &video->cache[video->last_added];
 		cfi->frame.timestamp = timestamp;
+		cfi->frame.content_pts_ns = content_pts_ns;
 		cfi->count = count;
 		cfi->skipped = 0;
 
diff --git a/libobs/media-io/video-io.h b/libobs/media-io/video-io.h
index fde6ca7c5..53ab15f17 100644
--- a/libobs/media-io/video-io.h
+++ b/libobs/media-io/video-io.h
@@ -122,6 +122,8 @@ struct video_data {
 	uint8_t *data[MAX_AV_PLANES];
 	uint32_t linesize[MAX_AV_PLANES];
 	uint64_t timestamp;
+	/* Pixel-content identity, independent of output cadence/repetition. */
+	uint64_t content_pts_ns;
 };
 
 struct video_output_info {
@@ -312,6 +314,8 @@ EXPORT bool video_output_active(const video_t *video);
 
 EXPORT const struct video_output_info *video_output_get_info(const video_t *video);
 EXPORT bool video_output_lock_frame(video_t *video, struct video_frame *frame, int count, uint64_t timestamp);
+EXPORT bool video_output_lock_frame_with_content(video_t *video, struct video_frame *frame, int count,
+						uint64_t timestamp, uint64_t content_pts_ns);
 EXPORT void video_output_unlock_frame(video_t *video);
 EXPORT uint64_t video_output_get_frame_time(const video_t *video);
 EXPORT void video_output_stop(video_t *video);
diff --git a/libobs/obs-encoder.c b/libobs/obs-encoder.c
index b26f66532..27df623a5 100644
--- a/libobs/obs-encoder.c
+++ b/libobs/obs-encoder.c
@@ -1436,7 +1436,7 @@ bool do_encode(struct obs_encoder *encoder, struct encoder_frame *frame, const u
 		}
 		ept->pts = frame->pts;
 		ept->cts = *frame_cts;
-		ept->content_pts_ns = *frame_cts;
+		ept->content_pts_ns = frame->content_pts_ns ? frame->content_pts_ns : *frame_cts;
 		ept->fer = fer_ts;
 	}
 	send_off_encoder_packet(encoder, success, received, &pkt);
@@ -1523,6 +1523,7 @@ static void receive_video(void *param, struct video_data *frame)
 
 	enc_frame.frames = 1;
 	enc_frame.pts = encoder->cur_pts;
+	enc_frame.content_pts_ns = frame->content_pts_ns;
 
 	if (do_encode(encoder, &enc_frame, &frame->timestamp))
 		encoder->cur_pts += encoder->timebase_num * encoder->frame_rate_divisor;
diff --git a/libobs/obs-encoder.h b/libobs/obs-encoder.h
index ec4fb7018..3b3063875 100644
--- a/libobs/obs-encoder.h
+++ b/libobs/obs-encoder.h
@@ -170,6 +170,7 @@ struct encoder_frame {
 
 	/** Presentation timestamp */
 	int64_t pts;
+	uint64_t content_pts_ns;
 };
 
 /** Encoder region of interest */
diff --git a/libobs/obs-video.c b/libobs/obs-video.c
index ed0d4b3bf..8b1542a23 100644
--- a/libobs/obs-video.c
+++ b/libobs/obs-video.c
@@ -814,7 +814,8 @@ static inline void output_video_data(struct obs_core_video_mix *video, struct vi
 
 	info = video_output_get_info(video->video);
 
-	locked = video_output_lock_frame(video->video, &output_frame, count, input_frame->timestamp);
+	locked = video_output_lock_frame_with_content(video->video, &output_frame, count, input_frame->timestamp,
+						    input_frame->content_pts_ns);
 	if (locked) {
 		if (video->gpu_conversion) {
 			set_gpu_converted_data(&output_frame, input_frame, info);
@@ -922,6 +923,13 @@ static const char *output_frame_gs_flush_name = "gs_flush";
 static const char *output_frame_output_video_data_name = "output_video_data";
 static inline void output_frame(struct obs_core_video_mix *video)
 {
+	/* Study-only switch: retain cadence/PTS and ownership, but trade an
+	 * immediate GPU map wait for the previous-surface pipeline interval. */
+	static int current_readback = -1;
+	if (current_readback < 0) {
+		const char *setting = getenv("PULSAR_RAW_CURRENT_READBACK");
+		current_readback = setting && strcmp(setting, "1") == 0;
+	}
 	const uint64_t frame_start = os_gettime_ns();
 	const bool raw_active = video->raw_was_active;
 	const bool gpu_active = video->gpu_was_active;
@@ -947,7 +955,7 @@ static inline void output_frame(struct obs_core_video_mix *video)
 	if (raw_active) {
 		profile_start(output_frame_download_frame_name);
 		const uint64_t download_start = os_gettime_ns();
-		frame_ready = download_frame(video, prev_texture, &frame);
+		frame_ready = download_frame(video, current_readback ? cur_texture : prev_texture, &frame);
 		obs_pipeline_stats_add_u64(&video->pipeline_stats.download_ns, os_gettime_ns() - download_start);
 		profile_end(output_frame_download_frame_name);
 	}
@@ -961,11 +969,19 @@ static inline void output_frame(struct obs_core_video_mix *video)
 	gs_leave_context();
 	profile_end(output_frame_gs_context_name);
 
-	if (raw_active && frame_ready) {
+	if (raw_active && frame_ready && video->vframe_info_buffer.size) {
 		struct obs_vframe_info vframe_info;
 		deque_pop_front(&video->vframe_info_buffer, &vframe_info, sizeof(vframe_info));
 
 		frame.timestamp = vframe_info.timestamp;
+		bool current_content = current_readback;
+#ifdef _WIN32
+		/* GPU encoding stages into the single copy_surfaces_encode set:
+		 * prev_texture may name that same just-written surface. Its pixels
+		 * are current even with the historical download index. */
+		current_content = current_content || gpu_active;
+#endif
+		frame.content_pts_ns = current_content ? obs->video.video_time : vframe_info.timestamp;
 		const uint64_t borrowed_schedule_start = os_gettime_ns();
 		output_borrowed_video_data(video, &frame);
 		obs_pipeline_stats_add_u64(&video->pipeline_stats.borrowed_schedule_ns,
diff --git a/plugins/win-dshow/virtualcam.c b/plugins/win-dshow/virtualcam.c
index 49464e4cd..444e9f703 100644
--- a/plugins/win-dshow/virtualcam.c
+++ b/plugins/win-dshow/virtualcam.c
@@ -556,7 +556,7 @@ static bool copy_telemetry_counter(uint64_t *destination, long long value)
 	return true;
 }
 
-static void snapshot_runtime_frame(struct video_queue_frame_metadata *metadata)
+static void snapshot_runtime_frame(struct video_queue_frame_metadata *metadata, uint64_t content_pts_ns)
 {
 	memset(metadata, 0, sizeof(*metadata));
 	proc_handler_t *ph = obs_get_proc_handler();
@@ -583,14 +583,14 @@ static void snapshot_runtime_frame(struct video_queue_frame_metadata *metadata)
 		copy_telemetry_counter(&program_revision, calldata_int(&cd, "program_revision")) &&
 		copy_telemetry_counter(&preview_revision, calldata_int(&cd, "preview_revision")) &&
 		copy_telemetry_counter(&role_map_revision, calldata_int(&cd, "role_map_revision"));
-	if (!valid || !counters_valid) {
+	if (!valid || !counters_valid || !content_pts_ns || content_pts_ns < pts_ns) {
 		calldata_free(&cd);
 		return;
 	}
 
 	metadata->server_seq = server_seq;
 	metadata->frame_id = frame_id;
-	metadata->pts_ns = pts_ns;
+	metadata->pts_ns = content_pts_ns;
 	metadata->program_revision = program_revision;
 	metadata->preview_revision = preview_revision;
 	metadata->role_map_revision = role_map_revision;
@@ -817,7 +817,7 @@ static void virtual_video(void *param, struct video_data *frame)
 	}
 
 	struct video_queue_frame_metadata metadata;
-	snapshot_runtime_frame(&metadata);
+	snapshot_runtime_frame(&metadata, frame->content_pts_ns ? frame->content_pts_ns : frame->timestamp);
 	const enum video_queue_pixel_format format = queue_pixel_format(vcam->output);
 	if (vcam->d3d11 && format == VIDEO_QUEUE_PIXEL_FORMAT_NV12) {
 		const bool published = pulsar_d3d11_return_producer_write(vcam->d3d11, frame->data, frame->linesize,
-- 
2.54.0.windows.1

