+static void copy_telemetry_identifier(char *destination, const char *value)
+{
+	if (!value)
+		value = "";
+	strncpy(destination, value, PULSAR_RUNTIME_TELEMETRY_IDENTIFIER_CAPACITY - 1);
+	destination[PULSAR_RUNTIME_TELEMETRY_IDENTIFIER_CAPACITY - 1] = '\0';
+}
+
+static bool copy_telemetry_counter(uint64_t *destination, long long value)
+{
+	/* calldata_int is signed.  Never let a missing/overflowed value wrap into
+	 * uint64 metadata: a DirectShow reader would otherwise report a fabricated
+	 * frame/PTS and could admit a false boundary. */
+	if (!destination || value < 0 || value > INT64_MAX)
+		return false;
+	*destination = (uint64_t)value;
+	return true;
+}
+
+/* The ProgramReturn producer is in the OBS process, while the DirectShow
+ * filter may be hosted by another process.  Copy the committed correlation
+ * envelope into each shared-memory slot so the reader can report exactly the
+ * frame it consumed.  A missing/disabled bridge is represented by valid=0;
+ * virtual camera delivery remains byte-for-byte legacy in that case. */
+static void snapshot_runtime_frame(struct video_queue_frame_metadata *metadata)
+{
+	memset(metadata, 0, sizeof(*metadata));
+	proc_handler_t *ph = obs_get_proc_handler();
+	if (!ph)
+		return;
+
+	calldata_t cd = {0};
+	if (!proc_handler_call(ph, PULSAR_RUNTIME_TELEMETRY_SNAPSHOT_PROC, &cd)) {
+		calldata_free(&cd);
+		return;
+	}
+
+	const bool valid = calldata_bool(&cd, "valid");
+	const long long server_seq = calldata_int(&cd, "server_seq");
+	const long long frame_id = calldata_int(&cd, "frame_id");
+	const long long pts_ns = calldata_int(&cd, "pts_ns");
+	const long long program_revision = calldata_int(&cd, "program_revision");
+	const long long preview_revision = calldata_int(&cd, "preview_revision");
+	const long long role_map_revision = calldata_int(&cd, "role_map_revision");
+	uint64_t converted_server_seq = 0;
+	uint64_t converted_frame_id = 0;
+	uint64_t converted_pts_ns = 0;
+	uint64_t converted_program_revision = 0;
+	uint64_t converted_preview_revision = 0;
+	uint64_t converted_role_map_revision = 0;
+	const bool counters_valid = copy_telemetry_counter(&converted_server_seq, server_seq) &&
+				    copy_telemetry_counter(&converted_frame_id, frame_id) &&
+				    copy_telemetry_counter(&converted_pts_ns, pts_ns) &&
+				    copy_telemetry_counter(&converted_program_revision, program_revision) &&
+				    copy_telemetry_counter(&converted_preview_revision, preview_revision) &&
+				    copy_telemetry_counter(&converted_role_map_revision, role_map_revision);
+	if (!valid || !counters_valid) {
+		/* metadata was zeroed above; keep valid=0 and fail closed for this slot. */
+		calldata_free(&cd);
+		return;
+	}
+	metadata->server_seq = converted_server_seq;
+	metadata->frame_id = converted_frame_id;
+	metadata->pts_ns = converted_pts_ns;
+	metadata->program_revision = converted_program_revision;
+	metadata->preview_revision = converted_preview_revision;
+	metadata->role_map_revision = converted_role_map_revision;
+	metadata->valid = 1U;
+	copy_telemetry_identifier(metadata->runtime_instance_id, calldata_string(&cd, "runtime_instance_id"));
+	copy_telemetry_identifier(metadata->command_id, calldata_string(&cd, "command_id"));
+	copy_telemetry_identifier(metadata->intent_id, calldata_string(&cd, "intent_id"));
+	copy_telemetry_identifier(metadata->take_command_id, calldata_string(&cd, "take_command_id"));
+	calldata_free(&cd);
+}
